rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"; }
    function isWriter() { return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["writer","admin"]); }

    // Users
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Articles
    match /articles/{articleId} {
      allow read: if resource.data.status == "published" || (isSignedIn() && (resource.data.authorId == request.auth.uid || isWriter()));
      allow create: if isWriter();
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Invitations
    match /invitations/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Newsletter
    match /newsletter/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }
  }
}